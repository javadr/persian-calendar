\documentclass{article}
\input{regression-test}
\usepackage{persian-calendar}
\makeatletter
% Fill the \pcalplanner column data for year #1, months #2..#2+5, as \pcal@yphalf does.
\def\HALF#1#2{\pcal@ypfirst{#1}{#2}{1}\pcal@ypfirst{#1}{#2+1}{2}\pcal@ypfirst{#1}{#2+2}{3}%
  \pcal@ypfirst{#1}{#2+3}{4}\pcal@ypfirst{#1}{#2+4}{5}\pcal@ypfirst{#1}{#2+5}{6}\pcal@ypfirst{#1}{#2+6}{7}%
  \pcal@yprows=0 \pcal@ypmonth1\pcal@ypmonth2\pcal@ypmonth3\pcal@ypmonth4\pcal@ypmonth5\pcal@ypmonth6}
\def\O#1{\csname pcal@ypo#1\endcsname}\def\L#1{\csname pcal@ypl#1\endcsname}
\def\ALL{\O1/\L1,\O2/\L2,\O3/\L3,\O4/\L4,\O5/\L5,\O6/\L6;\the\pcal@yprows}
\begin{document}
\START
\TEST{\pcalplanner data: weekday of the 1st (Saturday = 0) / length, rows}{
  \HALF{1405}{1}\ASSERT{\ALL}{0/31,3/31,6/31,2/31,5/31,1/31;37}
  \HALF{1405}{7}\ASSERT{\ALL}{4/30,6/30,1/30,3/30,5/30,0/29;36}
  \HALF{1403}{7}\ASSERT{\L6}{30}% leap year
}
\TEST{\pcal@ypin: 1 only for rows that hold a day}{
  \HALF{1405}{7}% Mehr starts on Wednesday (4), 30 days
  \ASSERT{\pcal@ypin{3}{1}\pcal@ypin{4}{1}\pcal@ypin{33}{1}\pcal@ypin{34}{1}}{0110}
}
\TEST{\pcalplannercell gets year, month, day and weekday (Saturday = 0)}{
  \HALF{1405}{7}\def\pcal@ypyear{1405}\def\pcal@ypbase{7}%
  \pcal@yprow=0 \pcal@ypwd=0 \pcal@yptoks{}\pcal@yprowloop
  % \HAS{tokens}: append y or n to \R as the rows built hold the tokens or not
  \def\R{}\def\HAS#1{\edef\x{\noexpand\pgfutil@in@{\detokenize{#1}}{\detokenize\expandafter{\the\pcal@yptoks}}}\x
    \edef\R{\R\ifpgfutil@in@ y\else n\fi}}
  % Mehr 1 is a Wednesday; Esfand 29 a Saturday; Esfand has no 30th in 1405
  \HAS{\pcalplannercell{1405}{7}{1}{4}}\HAS{\pcalplannercell{1405}{12}{29}{0}}\HAS{\pcalplannercell{1405}{12}{30}}
  \ASSERT{\R}{yyn}
}
\TEST{week numbers: ISO 8601 with Saturday weeks, week 1 holds the first Tuesday}{
  % \W{year}{m}{d}: append the week number of that day to \R (the setup is not expandable)
  \def\W#1#2#3{\pcal@ypweeksetup{#1}\edef\R{\R\pcal@ypweekno{#2}{#3},}}%
  % weeks per year: 1402 starts on Tuesday (53), 1403 Wednesday, 1405 Saturday (52)
  \def\R{}\def\N#1{\pcal@ypweeksetup{#1}\edef\R{\R\pcal@ypwn,}}\N{1402}\N{1403}\N{1405}\ASSERT{\R}{53,52,52,}
  % 1403: 1-3 Farvardin are week 53 of 1402; week 1 starts on Saturday 4 Farvardin
  \def\R{}\W{1403}{1}{1}\W{1403}{1}{3}\W{1403}{1}{4}\W{1403}{1}{10}\W{1403}{1}{11}\W{1403}{12}{30}%
  \ASSERT{\R}{53,53,1,1,2,52,}
  % 1404 starts on Friday: 1 Farvardin is week 52 of 1403, week 1 starts on 2 Farvardin
  \def\R{}\W{1404}{1}{1}\W{1404}{1}{2}\ASSERT{\R}{52,1,}
  % 1405 starts on Saturday; 29 Esfand 1405 is the Saturday of week 1 of 1406 (which starts on Sunday)
  \def\R{}\W{1405}{1}{1}\W{1405}{1}{7}\W{1405}{1}{8}\W{1405}{7}{1}\W{1405}{12}{28}\W{1405}{12}{29}%
  \ASSERT{\R}{1,1,2,27,52,1,}
  % 1402 starts on Tuesday: 1 Farvardin is in week 1, and the year reaches week 53
  \def\R{}\W{1402}{1}{1}\W{1402}{12}{27}\ASSERT{\R}{1,53,}
}
\TEST{week numbers: the mark goes into each Saturday and into 1 Farvardin}{
  \pcal@ypweekstrue
  \HALF{1403}{1}\def\pcal@ypyear{1403}\def\pcal@ypbase{1}\pcal@ypweeksetup{1403}%
  \pcal@yprow=0 \pcal@ypwd=0 \pcal@yptoks{}\pcal@yprowloop
  \def\R{}\def\HAS#1{\edef\x{\noexpand\pgfutil@in@{\detokenize{#1}}{\detokenize\expandafter{\the\pcal@yptoks}}}\x
    \edef\R{\R\ifpgfutil@in@ y\else n\fi}}
  % 1 Farvardin (Wednesday): week 53 of 1402; 4 Farvardin (Saturday): week 1; 5 Farvardin (Sunday): no mark
  \HAS{{1}{4}\pcal@ypweekcell {53}}\HAS{{4}{0}\pcal@ypweekcell {1}}\HAS{{5}{1}\pcal@ypweekcell}
  \ASSERT{\R}{yyn}
  \pcal@ypweeksfalse
}
\TEST{notes: a mark in the cell, a list grouped by month, every-year notes first}{
  \pcalplannernote{1-13}{every}\pcalplannernote{1405-1-13}{once}\pcalplannernote{1-2}{two}%
  \pcalplannernote{3-14}{june}\pcalplannernote{1406-1-1}{other year}\pcalplannernote{12-30}{leap only}%
  % record the list: [year-month] for a month, day) for a day, / between the texts of one day (the texts
  % themselves are typeset into a box and not recorded)
  \HALF{1405}{1}\def\pcal@ypyear{1405}\def\pcal@ypbase{1}\gdef\L{}\begingroup
    \def\pcalplannernotemonth#1#2{\xdef\L{\L[#1-#2]}}\def\pcalplannernoteday#1#2#3{\xdef\L{\L#3)}}%
    \def\pcalplannernotemonthsep{}\def\pcalplannernotesep{}\def\pcalplannernotetextsep{\xdef\L{\L/}}%
    \setbox0\vbox{\pcal@ypnotes}\endgroup
  \ASSERT{\L}{[1405-1]2)13)/[1405-3]14)}
  % 30 Esfand only in a leap year: 1403 yes, 1405 no
  \HALF{1403}{7}\def\pcal@ypyear{1403}\def\pcal@ypbase{7}\gdef\L{}\begingroup
    \def\pcalplannernotemonth#1#2{\xdef\L{\L[#1-#2]}}\def\pcalplannernoteday#1#2#3{\xdef\L{\L#3)}}%
    \setbox0\vbox{\pcal@ypnotes}\endgroup
  \ASSERT{\L}{[1403-12]30)}
  \HALF{1405}{7}\def\pcal@ypyear{1405}\def\pcal@ypbase{7}\gdef\L{}\begingroup
    \def\pcalplannernotemonth#1#2{\xdef\L{\L[#1-#2]}}\setbox0\vbox{\pcal@ypnotes}\endgroup
  \ASSERT{\L}{}
  % the mark: 13 Farvardin has it, 14 Farvardin does not
  \def\pcal@ypyear{1405}%
  \edef\R{\pcal@ypnotemark{1}{13}|\pcal@ypnotemark{1}{14}}\ASSERT{\detokenize\expandafter{\R}}{\detokenize{\pcalplannermark|}}
}
\END
