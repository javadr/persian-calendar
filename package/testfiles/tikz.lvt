\documentclass{article}
\input{regression-test}
\usepackage{tikz}
\usetikzlibrary{calendar}
\usepackage{persian-calendar}
\makeatletter
\def\DATES#1#2{\pgfkeys{/tikz/jalali dates=#1}\ASSERT{\tikz@lib@cal@start|\tikz@lib@cal@end}{#2}}
\def\IFDATE#1#2#3{\pgfcalendarifdate{#1}{#2}{\def\r{yes}}{\def\r{no}}\ASSERT{\r}{#3}}
\begin{document}
\START
\TEST{jalali dates converts both ends, `last' is the last day of the month}{
  \DATES{1405-01-01 to 1405-01-07}{2026-3-21|2026-3-27}
  \DATES{1405-01-01 to 1405-02-last}{2026-3-21|2026-5-22+-1}
  \DATES{1403-12-01 to 1403-12-last}{2025-2-19|2025-3-21+-1}
}
\TEST{jalali equals and jalali day of month test the Jalali date}{
  \IFDATE{2026-04-02}{jalali equals=1-13}{yes}
  \IFDATE{2026-04-02}{jalali equals=1-12}{no}
  \IFDATE{2026-03-21}{jalali day of month=1}{yes}
  \IFDATE{2026-03-21}{day of month=1}{no}
}
\TEST{a jalali calendar visits every day with the Jalali date set}{
  \gdef\acc{}%
  \tikz\calendar[jalali dates=1404-12-28 to 1405-01-02, jalali week list,
    day code={\xdef\acc{\acc\pcalendarcurrentyear-\pcalendarcurrentmonth-\pcalendarcurrentday/\pcalendarcurrentweekday,}}];%
  \ASSERT{\acc}{1404-12-28/5,1404-12-29/6,1405-1-1/0,1405-1-2/1,}
}
\TEST{Esfand has 30 days in a leap year and 29 otherwise}{
  \newcount\n
  \n=0 \tikz\calendar[jalali dates=1403-12-01 to 1403-12-last, jalali, day code={\global\advance\n 1}];%
  \ASSERT{\the\n}{30}
  \n=0 \tikz\calendar[jalali dates=1404-12-01 to 1404-12-last, jalali, day code={\global\advance\n 1}];%
  \ASSERT{\the\n}{29}
}
\TEST{TikZ month labels fire on the first of the Jalali month only}{
  \gdef\acc{}%
  \tikz\calendar[jalali dates=1405-01-25 to 1405-02-05, jalali week list, month label above centered,
    month code={\xdef\acc{\acc[\pcalendarcurrentmonth]}}];%
  \ASSERT{\acc}{[2]}
}
\TEST{jalali week list: Thursday in column 5, Friday in 6, Saturday starts a new row, right to left (pt)}{
  \gdef\acc{}%
  \tikz\calendar[jalali dates=1405-01-06 to 1405-01-08, jalali week list, day xshift=-1cm, day yshift=1cm,
    day code={\pgfpointtransformed{\pgfpointorigin}%
      \xdef\acc{\acc(\pcalendarcurrentday:\the\numexpr\dimexpr\pgf@x\relax/65536\relax,\the\numexpr\dimexpr\pgf@y\relax/65536\relax)}}];%
  \ASSERT{\acc}{(6:-142,0)(7:-171,0)(8:0,-28)}
}
\TEST{if (jalali equals=M-D) applies options to that day only}{
  \gdef\acc{}%
  \tikz\calendar[jalali dates=1405-01-11 to 1405-01-15, jalali, day code={}]
    if (jalali equals=1-13) [/utils/exec={\xdef\acc{\acc\pcalendarcurrentday}}];%
  \ASSERT{\acc}{13}
}
\newdimen\lab \newdimen\sat \newdimen\fri
\TEST{jalali month label above centered centres the label over a full week (|offset| < 0.5pt)}{
  % the label centre must be halfway between the outer edges of Saturday 22 and Friday 28 Farvardin
  \def\one#1{%
    \tikz{\calendar (cal) [jalali dates=1405-01-01 to 1405-01-last, jalali week list, day xshift=#1,
      jalali month label above centered, month text={Farvardin}, month code={\node[every month,name=lab]{\tikzmonthtext};}];
      \pgfextractx\lab{\pgfpointanchor{lab}{center}}%
      \ifdim#1<0pt
        \pgfextractx\sat{\pgfpointanchor{cal-2026-04-11}{east}}\pgfextractx\fri{\pgfpointanchor{cal-2026-04-17}{west}}%
      \else
        \pgfextractx\sat{\pgfpointanchor{cal-2026-04-11}{west}}\pgfextractx\fri{\pgfpointanchor{cal-2026-04-17}{east}}%
      \fi
      \lab=\dimexpr\lab-(\sat+\fri)/2\relax
      \xdef\r{\ifdim\lab<0.5pt \ifdim\lab>-0.5pt ok\else off\fi\else off\fi}}%
    \ASSERT{\r}{ok}}%
  \one{-3em}\one{3em}{\Large\one{-3em}}
}
\newdimen\ya \newdimen\yb
% Latin stand-ins: the test font has no Persian letters
\def\pcalendarweekdayshortname#1{w#1}
% \NEAR\result{dimen}{target}: \result is `ok' when the two are within 0.05pt
\def\NEAR#1#2#3{\dimen@=\dimexpr#2-(#3)\relax\ifdim\dimen@<0pt \dimen@=-\dimen@\fi
  \ifdim\dimen@<0.05pt \gdef#1{ok}\else\xdef#1{off(\the\dimexpr#2\relax)}\fi}
\TEST{jalali day boxes: one step wide and high, neighbours share one border line (anchors include the 0.4pt line)}{
  \tikz{\calendar (cal) [jalali dates=1405-01-22 to 1405-01-23, jalali week list, jalali day boxes,
      day xshift=-1cm, day yshift=0.6cm];
    \pgfextractx\sat{\pgfpointanchor{cal-2026-04-11}{east}}\pgfextractx\fri{\pgfpointanchor{cal-2026-04-11}{west}}%
    \advance\sat by-\fri \NEAR\r\sat{1cm+0.4pt}%
    \pgfextracty\ya{\pgfpointanchor{cal-2026-04-11}{north}}\pgfextracty\yb{\pgfpointanchor{cal-2026-04-11}{south}}%
    \advance\ya by-\yb \NEAR\s\ya{0.6cm+0.4pt}%
    \pgfextractx\ya{\pgfpointanchor{cal-2026-04-12}{east}}\advance\ya by-\fri \NEAR\t\ya{0.4pt}}%
  \ASSERT{\r}{ok}\ASSERT{\s}{ok}\ASSERT{\t}{ok}
}
\TEST{jalali month label above centered centres over a row of boxes (|offset| < 0.5pt)}{
  \tikz{\calendar (cal) [jalali dates=1405-01-01 to 1405-01-last, jalali week list, jalali day boxes,
      day xshift=-1cm, day yshift=0.6cm, jalali month label above centered,
      month text={Farvardin}, month code={\node[every month,name=lab]{\tikzmonthtext};}];
    \pgfextractx\lab{\pgfpointanchor{lab}{center}}%
    \pgfextractx\sat{\pgfpointanchor{cal-2026-04-11}{east}}\pgfextractx\fri{\pgfpointanchor{cal-2026-04-17}{west}}%
    \lab=\dimexpr\lab-(\sat+\fri)/2\relax
    \xdef\r{\ifdim\lab<0.5pt \ifdim\lab>-0.5pt ok\else off\fi\else off\fi}}%
  \ASSERT{\r}{ok}
}
\TEST{boxed initials share one border line with the first week, and sit inside their boxes}{
  % initials are deeper than digits; each kind is centred in its box, all boxes on one centre line
  \def\pcalendarweekdayshortname#1{gy}%
  \tikz{\calendar (cal) [jalali dates=1405-01-01 to 1405-01-07, jalali week list, jalali day boxes,
      jalali weekday initials, day yshift=0.6cm, every jalali weekday/.append style={name=ini}];
    \pgfextracty\ya{\pgfpointanchor{ini}{south}}\pgfextracty\yb{\pgfpointanchor{cal-2026-03-27}{north}}%
    \advance\ya by-\yb \NEAR\r\ya{-0.4pt}%
    \pgfextracty\ya{\pgfpointanchor{ini}{north}}\pgfextracty\yb{\pgfpointanchor{ini}{south}}%
    \advance\ya by-\yb \NEAR\s\ya{0.6cm+0.4pt}}%
  \ASSERT{\r}{ok}\ASSERT{\s}{ok}
}
\TEST{jalali weekday initials: seven initials per month, one row above the first week}{
  \newcount\n \n=0
  \tikz{\calendar (cal) [jalali dates=1405-01-01 to 1405-02-last, jalali week list, jalali weekday initials,
      day yshift=0.6cm, every jalali weekday/.append style={/utils/exec={\global\advance\n 1}},
      month code={}];}%
  \ASSERT{\the\n}{14}
}
\TEST{with boxes and initials a new month starts at least four rows below an unfinished week}{
  % 31 Farvardin 1405 is a Monday, so its week is unfinished; month yshift is far too small on purpose
  \tikz{\calendar (cal) [jalali dates=1405-01-31 to 1405-02-01, jalali week list, jalali day boxes,
      jalali weekday initials, day yshift=0.6cm, month yshift=1pt];
    \pgfextracty\ya{\pgfpointanchor{cal-2026-04-20}{base}}\pgfextracty\yb{\pgfpointanchor{cal-2026-04-21}{base}}%
    \advance\ya by-\yb \NEAR\r\ya{2.4cm}}%
  \ASSERT{\r}{ok}
}
\TEST{jalali day boxes fill every month to whole weeks with empty boxes}{
  % Farvardin 1405: Saturday to Monday, 5 weeks; Ordibehesht: Tuesday to Wednesday, 5 weeks
  \n=0 \tikz\calendar[jalali dates=1405-01-01 to 1405-02-last, jalali week list, jalali day boxes,
    every day/.append style={/utils/exec={\global\advance\n 1}}, month code={}];%
  \ASSERT{\the\n}{70}
  % a range that starts on a Wednesday and ends on a Sunday is padded to two whole weeks too
  \n=0 \tikz\calendar[jalali dates=1405-01-05 to 1405-01-09, jalali week list, jalali day boxes,
    every day/.append style={/utils/exec={\global\advance\n 1}}];%
  \ASSERT{\the\n}{14}
  % without boxes nothing is added
  \n=0 \tikz\calendar[jalali dates=1405-01-05 to 1405-01-09, jalali week list,
    every day/.append style={/utils/exec={\global\advance\n 1}}];%
  \ASSERT{\the\n}{5}
}
\TEST{jalali week columns: a row per weekday, Saturday on top, a new column after Friday (pt)}{
  \gdef\acc{}%
  \tikz\calendar[jalali dates=1405-01-06 to 1405-01-08, jalali week columns, day xshift=-1cm, day yshift=1cm,
    day code={\pgfpointtransformed{\pgfpointorigin}%
      \xdef\acc{\acc(\pcalendarcurrentday:\the\numexpr\dimexpr\pgf@x\relax/65536\relax,\the\numexpr\dimexpr\pgf@y\relax/65536\relax)}}];%
  \ASSERT{\acc}{(6:0,-142)(7:0,-171)(8:-28,0)}
}
\TEST{jalali week columns: a month is as many columns wide as it has weeks}{
  % 1405: Farvardin starts on Saturday, Ordibehesht on Tuesday (5 columns each), Khordad on Friday (6)
  \gdef\acc{}%
  \tikz\calendar[jalali dates=1405-01-01 to 1405-03-last, jalali week columns, jalali month label above centered,
    month code={\xdef\acc{\acc\tikz@lib@cal@width}}];%
  \ASSERT{\acc}{556}
  % with boxes, Farvardin is 5 whole columns of 7
  \n=0 \tikz\calendar[jalali dates=1405-01-01 to 1405-01-last, jalali week columns, jalali day boxes,
    every day/.append style={/utils/exec={\global\advance\n 1}}];%
  \ASSERT{\the\n}{35}
}
\TEST{inside jalali, day of month= means the Jalali day}{
  \gdef\acc{}%
  \tikz\calendar[dates=2026-03-20 to 2026-03-22, jalali,
    day code={\ifdate{day of month=1}{\xdef\acc{\acc\pcalendarcurrentday}}{}}];%
  \ASSERT{\acc}{1}
}
\END
