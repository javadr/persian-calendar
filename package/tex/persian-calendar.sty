\def\pcal@getymd #1-#2-#3;{\def\pcal@get@y{#1}\def\pcal@get@m{#2}\def\pcal@get@d{#3}}%
%
\def\pcal@modulo#1#2{\number\numexpr#1-((#1/#2)*#2)\relax}%
%
\def\pcal@gregoriantojalali#1{%
    \pcal@getymd #1;
    \pcal@y=\pcal@get@y%year
    \pcal@m=\pcal@get@m%month
    \pcal@d=\pcal@get@d%day
    \pcal@temp=\pcal@y
    \divide\pcal@temp by 100\relax
    \multiply\pcal@temp by 100\relax
    \pcal@yModHundred=\pcal@y
    \advance\pcal@yModHundred by -\pcal@temp\relax
    \ifodd\pcal@yModHundred
        \pcal@leapfalse
    \else
    \pcal@temp=\pcal@yModHundred
    \divide\pcal@temp by 2\relax
    \ifodd\pcal@temp\pcal@leapfalse
    \else
        \ifnum\pcal@yModHundred=0%
            \pcal@temp=\pcal@y
            \divide\pcal@temp by 400\relax
            \multiply\pcal@temp by 400\relax
            \ifnum\pcal@y=\pcal@temp\pcal@leaptrue\else\pcal@leapfalse\fi
        \else\pcal@leaptrue
        \fi
    \fi
    \fi
    \pcal@latini=31\relax
    \ifpcal@leap
        \pcal@latinii = 29\relax
    \else
        \pcal@latinii = 28\relax
    \fi
    \pcal@latiniii = 31\relax
    \pcal@latiniv  = 30\relax
    \pcal@latinv = 31\relax
    \pcal@latinvi = 30\relax
    \pcal@latinvii = 31\relax
    \pcal@latinviii = 31\relax
    \pcal@latinix = 30\relax
    \pcal@latinx = 31\relax
    \pcal@latinxi = 30\relax
    \pcal@latinxii = 31\relax
    \pcal@thirtytwo=32\relax
    \pcal@temp=\pcal@y
    \advance\pcal@temp by -17\relax
    \pcal@temptwo=\pcal@temp
    \divide\pcal@temptwo by 33\relax
    \multiply\pcal@temptwo by 33\relax
    \advance\pcal@temp by -\pcal@temptwo
    \ifnum\pcal@temp=\pcal@thirtytwo\pcal@kabisehfalse
    \else
        \pcal@temptwo=\pcal@temp
        \divide\pcal@temptwo by 4\relax
        \multiply\pcal@temptwo by 4\relax
        \advance\pcal@temp by -\pcal@temptwo
        \ifnum\pcal@temp=\z@\pcal@kabisehtrue\else\pcal@kabisehfalse\fi
    \fi
    \pcal@tempthree=\pcal@y                 % Number of Leap years
    \advance\pcal@tempthree by -1
    \pcal@temp=\pcal@tempthree              % T := (MY-1) div 4
    \divide\pcal@temp by 4\relax
    \pcal@temptwo=\pcal@tempthree           % T := T - ((MY-1) div 100)
    \divide\pcal@temptwo by 100\relax
    \advance\pcal@temp by -\pcal@temptwo
    \pcal@temptwo=\pcal@tempthree           % T := T + ((MY-1) div 400)
    \divide\pcal@temptwo by 400\relax
    \advance\pcal@temp by \pcal@temptwo
    \advance\pcal@tempthree by -611       % Number of Kabise years
    \pcal@temptwo=\pcal@tempthree           % T := T - ((SY+10) div 33) * 8
    \divide\pcal@temptwo by 33\relax
    \multiply\pcal@temptwo by 8\relax
    \advance\pcal@temp by -\pcal@temptwo
    \pcal@temptwo=\pcal@tempthree           %
    \divide\pcal@temptwo by 33\relax
    \multiply\pcal@temptwo by 33\relax
    \advance\pcal@tempthree by -\pcal@temptwo
    \ifnum\pcal@tempthree=32\advance\pcal@temp by 1\fi % if (SY+10) mod 33=32 then Inc(T);
    \divide\pcal@tempthree by 4\relax     % T := T - ((SY+10) mod 33) div 4
    \advance\pcal@temp by -\pcal@tempthree
    \advance\pcal@temp by -137            % T := T - 137  Adjust the value
    \pcal@persiani=31
    \advance\pcal@persiani by -\pcal@temp                 % now 31 - T is the persiani
    \pcal@persianii = 30\relax
    \ifpcal@kabiseh
        \pcal@persianiii = 30\relax
    \else
        \pcal@persianiii = 29\relax
    \fi
    \pcal@persianiv  = 31\relax
    \pcal@persianv   = 31\relax
    \pcal@persianvi  = 31\relax
    \pcal@persianvii = 31\relax
    \pcal@persianviii= 31\relax
    \pcal@persianix  = 31\relax
    \pcal@persianx   = 30\relax
    \pcal@persianxi  = 30\relax
    \pcal@persianxii = 30\relax
    \pcal@persianxiii= 30\relax
    \pcal@dn= 0\relax
    \pcal@sn= 0\relax
    \pcal@mminusone=\pcal@m
    \advance\pcal@mminusone by -1\relax
    \pcal@i=0\relax
    \ifnum\pcal@i < \pcal@mminusone
    \loop
    \advance \pcal@i by 1\relax
    \advance\pcal@dn by \csname pcal@latin\romannumeral\the\pcal@i\endcsname
    \ifnum\pcal@i<\pcal@mminusone \repeat
    \fi
    \advance \pcal@dn by \pcal@d
    \pcal@i=1\relax
    \pcal@sn = \pcal@persiani
    \ifnum \pcal@sn<\pcal@dn
    \loop
    \advance \pcal@i by 1\relax
    \advance\pcal@sn by \csname pcal@persian\romannumeral\the\pcal@i\endcsname
    \ifnum \pcal@sn<\pcal@dn \repeat
    \fi
    \ifnum \pcal@i < 4
        \pcal@m = 9 \advance\pcal@m by \pcal@i
        \advance \pcal@y by -622\relax
    \else
        \pcal@m = \pcal@i \advance \pcal@m by -3\relax
        \advance \pcal@y by -621\relax
    \fi
    \advance\pcal@sn by -\csname pcal@persian\romannumeral\the\pcal@i%
    \endcsname
    \ifnum\pcal@i = 1
        \pcal@d = \pcal@dn \advance \pcal@d by 30 \advance\pcal@d by -\pcal@persiani
    \else
        \pcal@d = \pcal@dn \advance \pcal@d by -\pcal@sn
    \fi
}
%
\newcount\pcal@gy%
\newcount\pcal@gm%
\newcount\pcal@gd%
\newcount\pcal@days%
%
\def\pcal@jalalitogregorian#1{%
    \pcal@getymd #1;
    \pcal@y=\pcal@get@y% jalali year
    \pcal@m=\pcal@get@m% jalali month
    \pcal@d=\pcal@get@d% jalali day
    %
    \ifnum\pcal@y<980
        \pcal@gy=621\relax
    \else
        \pcal@gy=1600\relax
        \advance\pcal@y by -979\relax
    \fi
    \pcal@days=\pcal@y
    \multiply\pcal@days by 365\relax
    %
    \pcal@temp=\pcal@y
    \divide\pcal@temp by 33\relax
    \multiply\pcal@temp by 8\relax
    \advance\pcal@days by \pcal@temp
    %%%%%%%%%%%%%%%%%%%%%%%%%%%
    \pcal@temp=\pcal@y
    \divide\pcal@temp by 33\relax
    \pcal@temptwo=\pcal@temp
    \multiply\pcal@temptwo by 33\relax
    \pcal@temp=\pcal@y
    \advance\pcal@temp by -\pcal@temptwo
    %%%%%\pcal@temp=\pcal@modulo{\pcal@y}{33}
    \advance\pcal@temp by 3\relax
    \divide\pcal@temp by 4\relax
    \advance\pcal@days by \pcal@temp\relax
    \advance\pcal@days by 78\relax
    \advance\pcal@days by \pcal@d\relax
    \ifnum\pcal@m < 7
        \pcal@temp=\pcal@m
        \advance\pcal@temp by -1\relax
        \multiply\pcal@temp by 31\relax
    \else
        \pcal@temp=\pcal@m
        \advance\pcal@temp by -7\relax
        \multiply\pcal@temp by 30\relax
        \advance\pcal@days by 186\relax
    \fi
    \advance\pcal@days by \pcal@temp\relax
    %
    \pcal@temp=\pcal@days
    \divide\pcal@temp by 146097\relax
    \multiply\pcal@temp by 400\relax
    \advance\pcal@gy by \pcal@temp\relax
    %
    \pcal@temp=\pcal@days
    \divide\pcal@temp by 146097\relax
    \pcal@temptwo=\pcal@temp
    \multiply\pcal@temptwo by 146097\relax
    \advance\pcal@days by -\pcal@temptwo\relax
    %
    %\advance\pcal@days by -\pcal@modulo{\pcal@days}{146097}\relax
    \ifnum\pcal@days > 36524
        \advance\pcal@days by -1\relax
        \pcal@temp=\pcal@days
        \advance\pcal@temp by -1\relax
        \divide\pcal@temp by 36524\relax
        \multiply\pcal@temp by 100\relax
        \advance\pcal@gy by \pcal@temp
    %
        \pcal@temp=\pcal@days
        \divide\pcal@temp by 36524\relax
        \pcal@temptwo=\pcal@temp
        \multiply\pcal@temptwo by 36524\relax
        \advance\pcal@days by -\pcal@temptwo\relax
    %    \pcal@temp=\pcal@modulo{\pcal@days}{36524}
    %    \advance\pcal@days by -\pcal@temp\relax
        \ifnum\pcal@days>366
            \advance\pcal@days by 1\relax
        \fi
    \fi
    \pcal@temp=\pcal@days
    \divide\pcal@temp by 1461\relax
    \multiply\pcal@temp by 4\relax
    \advance\pcal@gy by \pcal@temp
    %
    \pcal@temp=\pcal@days
    \divide\pcal@temp by 1461\relax
    \pcal@temptwo=\pcal@temp
    \multiply\pcal@temptwo by 1461\relax
    \advance\pcal@days by -\pcal@temptwo\relax
    %
    %\pcal@temp=\pcal@modulo{\pcal@days}{1461}
    %\advance\pcal@days by -\pcal@temp\relax
    \pcal@temp=\pcal@days
    \advance\pcal@temp by -1\relax
    \divide\pcal@temp by 365\relax
    \advance\pcal@gy by \pcal@temp
    \ifnum\pcal@days > 365
    %
        \advance\pcal@days by -1\relax
        \pcal@temp=\pcal@days
        \divide\pcal@temp by 365\relax
        \pcal@temptwo=\pcal@temp
        \multiply\pcal@temptwo by 365\relax
        \advance\pcal@days by -\pcal@temptwo\relax
    %
    %    \pcal@temp=\pcal@modulo{\pcal@days}{365}
    %    \advance\pcal@days by -\pcal@temp\relax
    \fi
    \pcal@gd=\pcal@days
    \advance\pcal@gd by 1\relax
    \pcal@leapfalse
    \ifnum\pcal@modulo{\pcal@gy}{4}=0
        \pcal@mod=\pcal@modulo{\pcal@gy}{100}
        \ifnum\ifnum\pcal@mod>0 1\else\ifnum\pcal@mod<0 1\else 0\fi\fi=1
            \pcal@leaptrue
        \fi
    \fi
    \ifnum\pcal@modulo{\pcal@gy}{400}=0
        \pcal@leaptrue
    \fi
    \pcal@loop=1
    \loop
        \ifnum\pcal@gd>\pcal@greg@month{\pcal@loop}
        \advance\pcal@gd by -\pcal@greg@month{\pcal@loop}\relax
        \advance\pcal@loop by 1\relax
    \repeat
    \pcal@gm=\pcal@loop
}
\def\pcal@greg@month#1{%
    \ifcase#1\or 31\or%
    \ifpcal@leap 29\else 28\fi%
    \or 31\or 30\or 31\or 30\or 31\or 31\or 30\or 31\or 30\or 31%
    \fi
}
%
\def\pdate#1{%
    \pcal@gregoriantojalali{#1}
    \number\pcal@d\space%
    \pcal@persian@month{\pcal@m}\space\number\pcal@y%
}
%
\def\gdate#1{%
    \pcal@jalalitogregorian{#1}
    \number\pcal@gd\space%
    \pcal@gregorian@month{\pcal@gm}\space\number\pcal@gy%
}
%
\def\pcalendar@unpack#1+{\count8=#1\relax}%
\def\pcalendardatetojulian#1#2{\edef\pcal@arg{#1}\expandafter\pcalendar@datetojulian\pcal@arg+/{#2}}
\def\pcalendar@datetojulian#1-#2-#3+#4/#5{%
    \count1=#1\relax% % jalali year
    \count2=#2\relax% % jalali month
    \edef\pcal@arg{#3}% % jalali day
    \count3=\pcal@arg\relax%
    \edef\pcal@@temp{#4}%
    \ifx\pcal@@temp\pgfutil@empty%
        \count8=0\relax%
    \else%
        \pcalendar@unpack#4%
    \fi%
    \pcal@jalalitogregorian{\count1-\count2-\count3}
    \pgfcalendardatetojulian{\pcal@gy-\pcal@gm-\pcal@gd}{#5}
    \advance#5 by \count8\relax
}%
%
\def\pcalendarjuliantodate#1#2#3#4{%
    \pgfcalendarjuliantodate#1#2#3#4
    \pcal@gregoriantojalali{#2-#3-#4}
    \let#2=\pcal@y
    \let#3=\pcal@m
    \let#4=\pcal@d
}%
%
\def\pisodate#1{%
    \pcal@gregoriantojalali{#1}
    \ifnum\pcal@d<10 0\fi\number\pcal@d\slash%
    \ifnum\pcal@m<10 0\fi\number\pcal@m\slash%
    \number\pcal@y%
}%
\def\gisodate#1{%
    \pcal@jalalitogregorian{#1}%
    \ifnum\pcal@gd<10 0\fi\number\pcal@gd\slash%
    \ifnum\pcal@gm<10 0\fi\number\pcal@gm\slash%
    \number\pcal@gy%
}%
%
\def\pcalendaryearname#1{%
\ifnum#1>-1\ifnum#1<2100\relax
    \pcal@thousandth=#1
    \pcal@decimal=#1
    \divide\pcal@thousandth by 100\relax
    \pcal@temp=\pcal@thousandth
    \multiply\pcal@temp by 100\relax
    \advance\pcal@decimal by -\pcal@temp\relax
%
    \pcal@first=\pcal@thousandth
    \pcal@temp=\pcal@thousandth
    \divide\pcal@temp by 3\relax
    \multiply\pcal@temp by 3\relax
    \advance\pcal@first by -\pcal@temp\relax
%
    \pcal@second=\pcal@decimal
    \pcal@temp=\pcal@decimal
    \divide\pcal@temp by 12\relax
    \multiply\pcal@temp by 12\relax
    \advance\pcal@second by -\pcal@temp\relax
    \ifcase\pcal@first
        \ifcase\pcal@second
        مار\or اسب\or گوسفند\or میمون\or مرغ\or سگ\or خوک\or موش\or گاو\or پلنگ\or خرگوش\or نهنگ\fi\or
        \ifcase\pcal@second
        مرغ\or سگ\or خوک\or موش\or گاو\or پلنگ\or خرگوش\or نهنگ\or مار\or اسب\or گوسفند\or میمون\fi\or
        \ifcase\pcal@second
        گاو\or پلنگ\or خرگوش\or نهنگ\or مار\or اسب\or گوسفند\or میمون\or مرغ\or سگ\or خوک\or موش\fi
    \fi
\fi\fi
}%
%
\def\pcal@persian@month#1{\ifcase#1\or فروردین\or اردیبهشت\or خرداد\or تیر\or مرداد\or شهریور%
\or مهر\or آبان\or آذر\or دی\or بهمن\or اسفند\fi}%
\def\pcal@gregorian@month#1{\ifcase#1\or ژانویه\or فوریه\or مارس\or آوریل\or می\or ژوئن%
\or جولای\or آگوست\or سپتامبر\or اکتبر\or نوامبر\or دسامبر\fi}%
%
\def\pcalendarweekdayname#1{\ifcase#1 شنبه\or یکشنبه\or دوشنبه\or سه‌شنبه\or چهارشنبه\or پنجشنبه\or جمعه\fi}%
\def\pcalendarweekdayshortname#1{\ifcase#1 ش\or ی\or د\or س\or چ\or پ\or ج\fi}%
\def\pcalendarmonthname#1{\pcal@persian@month{#1}}%
\def\pcalendargregorianmonthname#1{\pcal@gregorian@month{#1}}%
%
% ---- Jalali calendars with the TikZ `calendar' library ----
% Grouped because the converters use \loop and pgfcalendar runs its days in a \loop.
\def\pcal@tojalali#1#2#3{\begingroup\pcal@gregoriantojalali{#1-#2-#3}%
    \xdef\pcal@jy{\the\pcal@y}\xdef\pcal@jm{\the\pcal@m}\xdef\pcal@jd{\the\pcal@d}\endgroup}%
\def\pcal@togregorian#1{\begingroup\pcal@jalalitogregorian{#1}%
    \xdef\pcal@iso{\the\pcal@gy-\the\pcal@gm-\the\pcal@gd}\endgroup}%
% Jalali date of the day being drawn; weekday counts from Saturday = 0, like \pcalendarweekdayname.
\def\pcal@current{%
    \pcal@tojalali\pgfcalendarcurrentyear\pgfcalendarcurrentmonth\pgfcalendarcurrentday
    \let\pcalendarcurrentyear\pcal@jy\let\pcalendarcurrentmonth\pcal@jm\let\pcalendarcurrentday\pcal@jd
    \pcal@temp=\pgfcalendarcurrentweekday\advance\pcal@temp by 2\relax
    \ifnum\pcal@temp>6 \advance\pcal@temp by -7\relax\fi
    \edef\pcalendarcurrentweekday{\the\pcal@temp}}%
\def\pcal@iflast#1{\pgfutil@in@{last}{#1}}%
\def\pcal@ifdatejalali{\pcal@tojalali\pgfcalendarifdateyear\pgfcalendarifdatemonth\pgfcalendarifdateday}%
\newif\ifpcal@boxes \newif\ifpcal@initials
% One cell: #1 node options, #2 text. A box is one day step wide and high, its right edge on the day's
% position like a plain day (anchor base east); fixed text height and depth keep the rows level.
\def\pcal@cell#1#2{\ifpcal@boxes
    \node[every day,draw,anchor=base east,inner sep=0pt,text height=1.6ex,text depth=.4ex,
      minimum width={abs(\tikz@lib@cal@xshift)},minimum height={abs(\tikz@lib@cal@yshift)},#1]{#2};%
  \else\node[every day,#1]{#2};\fi}%
% Drop to a new month: at least three rows (four with initials) so the label and the initials fit
% below an unfinished last week; only with boxes or initials, so plain lists keep `month yshift'.
\def\pcal@nextmonth{\pgfmathsetlength{\pgf@y}{\tikz@lib@cal@month@yshift}%
    \ifpcal@boxes\pcal@roomfornext\else\ifpcal@initials\pcal@roomfornext\fi\fi
    \pgftransformyshift{-\pgf@y}}%
\def\pcal@roomfornext{\pgfmathsetlength{\pgf@ya}{\tikz@lib@cal@yshift}%
    \ifpcal@initials\pgf@ya=4\pgf@ya\else\pgf@ya=3\pgf@ya\fi
    \ifdim\pgf@y<\pgf@ya\pgf@y=\pgf@ya\fi}%
% Empty boxes before the first day and after the last day of a month (or of the calendar's range),
% so every month is a full rectangle. Runs at the start of the row, before the day is placed.
\newcount\pcal@lo \newcount\pcal@hi \newif\ifpcal@last
\def\pcal@pad{\pgfmathsetlength{\pgf@x}{\tikz@lib@cal@xshift}\edef\pcal@step{\the\pgf@x}%
    \pcal@lo=0 \pcal@hi=\pcalendarcurrentweekday\advance\pcal@hi by -1
    \ifnum\pcalendarcurrentday=1 \pcal@padrow\else
      \ifnum\pgfcalendarcurrentjulian=\pgfcalendarbeginjulian\relax\pcal@padrow\fi\fi
    \pcal@checklast
    \ifpcal@last\pcal@lo=\pcalendarcurrentweekday\advance\pcal@lo by 1 \pcal@hi=6 \pcal@padrow\fi}%
\def\pcal@padrow{\pcal@padcell0\pcal@padcell1\pcal@padcell2\pcal@padcell3\pcal@padcell4\pcal@padcell5\pcal@padcell6}%
\def\pcal@padcell#1{\ifnum#1<\pcal@lo\else\ifnum#1>\pcal@hi\else
    {\pgf@x=#1\dimexpr\pcal@step\relax\pgftransformxshift{\pgf@x}\pcal@cell{}{}}\fi\fi}%
% \ifpcal@last: the day is the last of its Jalali month (tomorrow is the 1st) or of the calendar.
\def\pcal@checklast{\pcal@lastfalse
    \ifnum\pgfcalendarcurrentjulian=\pgfcalendarendjulian\relax\pcal@lasttrue\else
      {\pgfutil@tempcnta=\pgfcalendarcurrentjulian\advance\pgfutil@tempcnta by 1
       \pgfcalendarjuliantodate{\pgfutil@tempcnta}\pcal@ny\pcal@nm\pcal@nd
       \pcal@tojalali\pcal@ny\pcal@nm\pcal@nd\ifnum\pcal@jd=1 \global\pcal@lasttrue\fi}\fi}%
% The row of initials, one day step above the first week, Saturday in column 0.
\def\pcal@initials{{\pgfmathsetlength{\pgf@x}{\tikz@lib@cal@xshift}\edef\pcal@step{\the\pgf@x}%
    \pgfmathsetlength{\pgf@y}{\tikz@lib@cal@yshift}\pgftransformyshift{\pgf@y}%
    \pcal@initial0\pcal@initial1\pcal@initial2\pcal@initial3\pcal@initial4\pcal@initial5\pcal@initial6}}%
\def\pcal@initial#1{{\pgf@x=#1\dimexpr\pcal@step\relax\pgftransformxshift{\pgf@x}%
    \pcal@cell{every jalali weekday}{\pcalendarweekdayshortname{#1}}}}%
\pgfkeys{%
  /pgf/calendar/jalali day of month/.code={\pcal@ifdatejalali\ifnum#1=\pcal@jd\relax\pgfcalendarmatchestrue\fi},
  /pgf/calendar/jalali equals/.code args={#1-#2}{\pcal@ifdatejalali
    \ifnum#1=\pcal@jm\relax\ifnum#2=\pcal@jd\relax\pgfcalendarmatchestrue\fi\fi},
  % jalali dates=Y-M-D to Y-M-D; the day may be `last'
  /tikz/jalali dates/.code args={#1to#2}{\pcal@togregorian{#1}\let\pcal@start\pcal@iso
    \pcal@getymd#2;\expandafter\pcal@iflast\expandafter{\pcal@get@d}%
    \ifpgfutil@in@ % first day of the next month, minus one
      \pcal@temp=\pcal@get@m\relax\pcal@temptwo=\pcal@get@y\relax
      \ifnum\pcal@temp=12 \pcal@temp=1 \advance\pcal@temptwo by 1 \else\advance\pcal@temp by 1 \fi
      \edef\pcal@arg{\the\pcal@temptwo-\the\pcal@temp-1}\expandafter\pcal@togregorian\expandafter{\pcal@arg}%
      \edef\pcal@iso{\pcal@iso+-1}%
    \else\pcal@togregorian{#2}\fi
    \pgfkeysalso{/tikz/dates/.expanded=\pcal@start to\pcal@iso}},
  % Prepended so \pcalendarcurrent... are set before any other per-day code.
  /tikz/jalali/.code={\expandafter\def\expandafter\tikz@before@day\expandafter{\expandafter\pcal@current\tikz@before@day}%
    \pgfkeysalso{/pgf/calendar/day of month/.code={\pgfkeysalso{/pgf/calendar/jalali day of month=##1}},
      /tikz/day text={\pcalendarcurrentday},
      /tikz/month text={\pcalendarmonthname{\pcalendarcurrentmonth}\space\pcalendarcurrentyear}}},
  % Like TikZ's `week list', but weeks run Saturday to Friday. Use a negative `day xshift' for right to left.
  /tikz/jalali week list/.style={jalali,
    execute before day scope={\ifdate{day of month=1}{\ifdate{equals=\pgfcalendarbeginiso}{}{\pcal@nextmonth}%
      \ifpcal@initials\pcal@initials\fi}{}%
      \ifpcal@boxes\pcal@pad\fi},
    execute at begin day scope={\pgfmathsetlength\pgf@x{\tikz@lib@cal@xshift}%
      \pgf@x=\pcalendarcurrentweekday\pgf@x\pgftransformxshift{\pgf@x}},
    execute after day scope={\ifdate{Friday}{\pgfmathsetlength{\pgf@y}{\tikz@lib@cal@yshift}\pgftransformyshift{-\pgf@y}}{}},
    tikz@lib@cal@width=7},
  % Each day is a box one day step wide and high, so the boxes join into a grid.
  /tikz/jalali day boxes/.code={\pcal@boxestrue
    \pgfkeysalso{/tikz/day code={\pcal@cell{name=\pgfcalendarsuggestedname}{\tikzdaytext}}}},
  % A row of weekday initials above each month (with `jalali week list').
  /tikz/jalali weekday initials/.code={\pcal@initialstrue},
  /tikz/every jalali weekday/.style={},
  % Like TikZ's `month label above centered', but centred on the days: the shift is half the width of
  % `30' in the current font plus the inner sep of a day node, not a fixed 1.5ex, so it follows the font size.
  /tikz/jalali month label above centered/.style={
    execute before day scope={\ifdate{day of month=1}{{%
      \pgfmathsetlength{\pgf@xa}{\tikz@lib@cal@xshift}%
      \pgf@xb=\tikz@lib@cal@width\pgf@xa\advance\pgf@xb by-\pgf@xa\pgf@xb=.5\pgf@xb
      \ifpcal@boxes % a box is one step wide and ends at the day's position
        \ifdim\pgf@xa<0pt \advance\pgf@xb by.5\pgf@xa\else\advance\pgf@xb by-.5\pgf@xa\fi
      \else
        \pgfinterruptpicture\global\setbox\pgfutil@tempboxa\hbox{30}\endpgfinterruptpicture % TikZ draws in \nullfont
        \advance\pgf@xb by-.5\wd\pgfutil@tempboxa
        \pgfmathsetlength{\pgf@xa}{\pgfkeysvalueof{/pgf/inner xsep}}\advance\pgf@xb by-\pgf@xa
      \fi
      \pgftransformxshift{\pgf@xb}%
      \pgfmathsetlength{\pgf@y}{\tikz@lib@cal@yshift}\pgf@ya=1.25\pgf@y
      \ifpcal@initials\advance\pgf@ya by\pgf@y\fi % above the row of initials
      \ifpcal@boxes\advance\pgf@ya by.25\pgf@y\fi % clear of the box tops
      \pgftransformyshift{\pgf@ya}%
      \tikzmonthcode}}{}},
    every month/.append style={anchor=base}}}%
