\def\pcalendardatetojulian{\pcaldatetojulian}
\def\pcalendarjuliantodate{\pcaljuliantodate}
\def\pcalendaryearname{\pcalyearname}
\def\pcalendarmonthname{\pcalmonthname}
\def\pcalendargregorianmonthname{\pcalgregorianmonthname}
\def\pcalendarweekdayname{\pcalweekdayname}
\def\pcalendarweekdayshortname{\pcalweekdayshortname}
